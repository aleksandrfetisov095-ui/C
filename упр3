#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdint.h>
#include <math.h>

#define BIAS 127        // Смещение порядка
#define EXP_BITS 8      // Бит под порядок
#define MANT_BITS 23    // Бит под мантиссу

typedef union {
    float f;            // Значение как float
    struct {
        uint32_t mantissa : MANT_BITS; // 23 бита
        uint32_t exponent : EXP_BITS;  // 8 бит
        uint32_t sign : 1;             // 1 бит
    } parts;
    uint32_t raw;       // Сырое 32-битное представление
} FP_IEEE754;

// Вывод битового представления
void print_bits(FP_IEEE754 num) {
    printf("S:%d E:%02X (%d) M:", 
           num.parts.sign, 
           num.parts.exponent, 
           (int)num.parts.exponent - BIAS);
    
    // Печатаем мантиссу с восстановленной скрытой единицей (если не ноль)
    if (num.parts.exponent != 0 || num.parts.mantissa != 0) {
        uint32_t m = num.parts.mantissa | (1U << MANT_BITS);
        printf("1.");
        for (int i = MANT_BITS - 1; i >= 0; i--) {
            printf("%d", (m >> i) & 1);
        }
    } else {
        printf("0.0...");
    }
    printf("\n");
}

// Основная функция сложения/вычитания
FP_IEEE754 fp_add_sub(FP_IEEE754 a, FP_IEEE754 b, int is_subtraction) {
    FP_IEEE754 res;
    
    // Обработка особых случаев (Ноль, Inf, NaN) упрощена для учебного примера
    // Считаем, что входные числа нормализованные конечные значения
    
    // 1. Извлечение данных и восстановление скрытой единицы
    // Если порядок 0 и мантисса 0 -> число 0. Скрытой единицы нет.
    int is_zero_a = (a.raw == 0);
    int is_zero_b = (b.raw == 0);
    
    if (is_zero_a) return is_subtraction ? (FP_IEEE754){.raw = b.raw ^ 0x80000000} : b; // 0-Y или 0+Y
    if (is_zero_b) return a; // X-0 или X+0

    uint32_t m1 = a.parts.mantissa | (1U << MANT_BITS);
    uint32_t m2 = b.parts.mantissa | (1U << MANT_BITS);
    
    int e1 = a.parts.exponent;
    int e2 = b.parts.exponent;
    int s1 = a.parts.sign;
    int s2 = b.parts.sign;

    // 2. Уравнивание порядков
    int de = e1 - e2;
    if (de > 0) {
        if (de <= MANT_BITS + 1) m2 >>= de; else m2 = 0;
    } else if (de < 0) {
        e1 = e2; // Порядок результата равен большему (E2)
        if (-de <= MANT_BITS + 1) m1 >>= -de; else m1 = 0;
    }
    // Теперь e1 содержит порядок результата (больший из исходных)

    // 3. Действие над мантиссами (по Таблице 1 из файла)
    // ACTION = S1 ^ S2 ^ (0 если +, 1 если -)
    int action = s1 ^ s2 ^ (is_subtraction ? 1 : 0);
    
    int32_t res_m_signed = 0;
    int s_res = 0;

    if (action == 0) {
        // Сложение модулей
        res_m_signed = (int32_t)m1 + (int32_t)m2;
        
        // Знак результата по таблице
        if (s1 == 0 && s2 == 0) s_res = 0;
        else if (s1 == 1 && s2 == 1) s_res = 1;
        else if (s1 == 0 && s2 == 1 && is_subtraction) s_res = 0; 
        else if (s1 == 1 && s2 == 0 && is_subtraction) s_res = 1; 
    } else {
        // Вычитание модулей
        if (m1 >= m2) {
            res_m_signed = (int32_t)m1 - (int32_t)m2;
            // Знак по таблице для |M1| >= |M2|
            if (s1 == 0 && s2 == 1) s_res = 0;
            else if (s1 == 1 && s2 == 0) s_res = 1;
            else if (s1 == 0 && s2 == 0) s_res = 0; 
            else if (s1 == 1 && s2 == 1) s_res = 1; 
        } else {
            res_m_signed = (int32_t)m2 - (int32_t)m1;
            // Знак противоположный
            if (s1 == 0 && s2 == 1) s_res = 1;
            else if (s1 == 1 && s2 == 0) s_res = 0;
            else if (s1 == 0 && s2 == 0) s_res = 1; 
            else if (s1 == 1 && s2 == 1) s_res = 0; 
        }
    }

    // 4. Анализ нуля
    if (res_m_signed == 0) {
        res.raw = 0; // +0.0
        return res;
    }

    uint32_t final_m = (uint32_t)res_m_signed;
    int final_e = e1;

    // 5. Нормализация
    
    // А. Переполнение (бит 24 установлен, т.к. 23 бита мантиссы + 1 скрытый = 24 позиции)
    // Сумма двух чисел вида 1.xxxx может дать 1x.xxxx (25 бит). Бит 24 - это перенос за пределы 24-битной мантиссы (с учетом скрытой)
    // В нашем случае m1/m2 были 24 бита (1<<23 | mantissa). Сумма до 25 бит.
    // Бит 24 (считая от 0) - это 25-й бит.
    if (final_m & (1U << (MANT_BITS + 1))) {
        final_m >>= 1;
        final_e++;
    }
    
    // Б. Потеря значимости (нет скрытой единицы, бит 23 не установлен)
    while (!(final_m & (1U << MANT_BITS)) && final_e > 0) {
        final_m <<= 1;
        final_e--;
    }

    // 6. Сборка результата
    res.parts.sign = s_res;
    res.parts.exponent = final_e;
    // Отбрасываем скрытую единицу (бит 23) для хранения в поле mantissa (23 бита)
    res.parts.mantissa = final_m & ((1U << MANT_BITS) - 1);

    return res;
}

int main() {
    float dx, dy;
    int op;

    printf("--- Калькулятор IEEE 754 Float (Bias 127) ---\n");
    printf("Введите X: ");
    scanf("%f", &dx);
    printf("Введите Y: ");
    scanf("%f", &dy);
    printf("Операция (1 - Сложение, 2 - Вычитание): ");
    scanf("%d", &op);

    FP_IEEE754 x, y;
    x.f = dx;
    y.f = dy;

    printf("\n--- Операнды ---\n");
    printf("X: %f\n", x.f); print_bits(x);
    printf("Y: %f\n", y.f); print_bits(y);

    FP_IEEE754 res = fp_add_sub(x, y, (op == 2));

    printf("\n--- Результат ---\n");
    printf("Z: %f\n", res.f); print_bits(res);
    
    float expected = (op == 1) ? (dx + dy) : (dx - dy);
    printf("Ожидается (CPU): %f\n", expected);

    // Проверка точности (допустимая погрешность float)
    if (fabs(res.f - expected) < 1e-5 * fabs(expected)) {
        printf("Статус: OK\n");
    } else {
        printf("Статус: Mismatch (возможны особенности округления)\n");
    }

    return 0;
}
