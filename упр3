#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdint.h>
#include <math.h>

// --- КОНСТАНТЫ ФОРМАТА ИЗ ФАЙЛА ---
#define BIAS 16383      // Смещение порядка (3FFFh)
#define EXP_BITS 15     // Количество бит под порядок
#define MANT_BITS 16    // Количество бит под мантиссу (дробная часть)
// Всего: 1 (знак) + 15 (порядок) + 16 (мантисса) = 32 бита

typedef union {
    float f;            // Для ввода/вывода человеком
    struct {
        uint32_t mantissa : MANT_BITS; // Мантисса (16 бит)
        uint32_t exponent : EXP_BITS;  // Порядок (15 бит)
        uint32_t sign : 1;             // Знак (1 бит)
    } parts;
    uint32_t raw;       // Сырое 32-битное представление
} FP_CUSTOM;

// Вспомогательная функция для вывода битов
void print_bits_custom(uint32_t val) {
    printf("S: %d | E: %04X (%d) | M: ", 
           (val >> 31) & 1, 
           (val >> 16) & 0x7FFF, 
           ((int)((val >> 16) & 0x7FFF)) - BIAS);
    
    // Выводим мантиссу с подразумеваемой единицей 1.M
    uint32_t m = (val & 0xFFFF) | (1 << MANT_BITS); 
    printf("1.");
    for (int i = MANT_BITS - 1; i >= 0; i--) {
        printf("%d", (m >> i) & 1);
    }
    printf("\n");
}

// Преобразование double -> Наш формат (Bias 16383)
FP_CUSTOM to_custom(double v) {
    FP_CUSTOM r;
    if (v == 0.0) { r.raw = 0; return r; }

    r.parts.sign = (v < 0) ? 1 : 0;
    double av = fabs(v);
    int p = 0;

    // Нормализация к виду 1.M * 2^P
    while (av >= 2.0) { av /= 2.0; p++; }
    while (av < 1.0) { av *= 2.0; p--; }

    // Расчет смещенного порядка
    int e = p + BIAS;
    if (e < 0) e = 0;
    if (e > 0x7FFF) e = 0x7FFF; // Ограничение диапазона 15 бит
    r.parts.exponent = e;

    // Формирование мантиссы (убираем 1., сдвигаем в целое)
    av -= 1.0;
    // Умножаем на 2^16, чтобы получить 16 бит дробной части
    uint32_t m = (uint32_t)(av * (1ULL << MANT_BITS));
    
    // Округление
    if ((av * (1ULL << (MANT_BITS + 1))) % 2 != 0) m += 1;
    
    r.parts.mantissa = m & 0xFFFF;
    return r;
}

// Преобразование Наш формат -> double
double from_custom(FP_CUSTOM r) {
    if (r.raw == 0) return 0.0;
    
    int p = ((int)r.parts.exponent) - BIAS;
    // Восстанавливаем 1.M
    double m_val = 1.0 + (double)r.parts.mantissa / (1ULL << MANT_BITS);
    
    double v = m_val * pow(2.0, p);
    return (r.parts.sign) ? -v : v;
}

// Основная функция сложения/вычитания
FP_CUSTOM fp_add_sub(FP_CUSTOM a, FP_CUSTOM b, int is_subtraction) {
    FP_CUSTOM res;
    
    // 1. Извлечение данных
    int s1 = a.parts.sign;
    int e1 = a.parts.exponent;
    // Добавляем скрытую единицу для вычислений (бит 16)
    uint32_t m1 = a.parts.mantissa | (1U << MANT_BITS); 

    int s2 = b.parts.sign;
    int e2 = b.parts.exponent;
    uint32_t m2 = b.parts.mantissa | (1U << MANT_BITS);

    // 2. Уравнивание порядков
    int de = e1 - e2;
    if (de > 0) {
        // Сдвигаем мантиссу второго числа вправо
        if (de < 32) m2 >>= de; else m2 = 0;
    } else if (de < 0) {
        // Сдвигаем мантиссу первого числа вправо
        e1 = e2; // Порядок результата равен большему (E2)
        if (-de < 32) m1 >>= -de; else m1 = 0;
    }
    // Теперь e1 содержит порядок результата (больший из двух)

    // 3. Действие над мантиссами (по Таблице 1 из файла)
    // Формула: ACTION = S1 ^ S2 ^ (0 если +, 1 если -)
    int action = s1 ^ s2 ^ (is_subtraction ? 1 : 0);
    
    int32_t res_m_signed = 0;
    int s_res = 0;

    if (action == 0) {
        // Сложение модулей
        res_m_signed = (int32_t)m1 + (int32_t)m2;
        
        // Определение знака по таблице
        if (s1 == 0 && s2 == 0) s_res = 0;
        else if (s1 == 1 && s2 == 1) s_res = 1;
        else if (s1 == 0 && s2 == 1 && is_subtraction) s_res = 0; // 0 - (-1) -> +
        else if (s1 == 1 && s2 == 0 && is_subtraction) s_res = 1; // -1 - 0 -> -
    } else {
        // Вычитание модулей
        if (m1 >= m2) {
            res_m_signed = (int32_t)m1 - (int32_t)m2;
            // Знак определяется таблицей для случая |M1| >= |M2|
            if (s1 == 0 && s2 == 1) s_res = 0;
            else if (s1 == 1 && s2 == 0) s_res = 1;
            else if (s1 == 0 && s2 == 0) s_res = 0; // X-Y, X>Y -> +
            else if (s1 == 1 && s2 == 1) s_res = 1; // -X - (-Y), |X|>|Y| -> -
        } else {
            res_m_signed = (int32_t)m2 - (int32_t)m1;
            // Знак противоположный
            if (s1 == 0 && s2 == 1) s_res = 1;
            else if (s1 == 1 && s2 == 0) s_res = 0;
            else if (s1 == 0 && s2 == 0) s_res = 1; // X-Y, Y>X -> -
            else if (s1 == 1 && s2 == 1) s_res = 0; // -X - (-Y), |Y|>|X| -> +
        }
    }

    // 4. Анализ нуля
    if (res_m_signed == 0) {
        res.raw = 0;
        return res;
    }

    // Если результат отрицательный (в ДК), берем модуль (преобразуем в ПК)
    // В нашей логике выше мы всегда вычитали меньшее из большего, 
    // поэтому res_m_signed всегда положительный, а знак лежит в s_res.
    // Но если бы мы использовали прямой арифметический сумматор со знаком, нужно было бы делать NOT+1.
    
    uint32_t final_m = (uint32_t)res_m_signed;
    int final_e = e1;

    // 5. Нормализация
    
    // А. Переполнение (бит 17 установлен, т.к. мантисса 16 бит + 1 скрытый = 17 бит макс сумма)
    // Мы используем 16 бит для дробной части + 1 бит целой (скрытой). Итого работаем с 17 битами.
    // Бит 16 - это скрытая единица. Бит 17 - переполнение.
    if (final_m & (1U << (MANT_BITS + 1))) {
        final_m >>= 1;
        final_e++;
    }
    
    // Б. Потеря значимости (нет скрытой единицы, бит 16 не установлен)
    while (!(final_m & (1U << MANT_BITS)) && final_e > 0) {
        final_m <<= 1;
        final_e--;
    }

    // 6. Сборка результата
    res.parts.sign = s_res;
    res.parts.exponent = final_e;
    // Отбрасываем скрытую единицу для хранения (оставляем только младшие 16 бит)
    res.parts.mantissa = final_m & 0xFFFF;

    return res;
}

int main() {
    double dx, dy;
    int op;

    printf("--- Калькулятор ЧПТ (Bias 16383, 15 бит порядок, 16 бит мантисса) ---\n");
    printf("Введите X (десятичное): ");
    scanf("%lf", &dx);
    printf("Введите Y (десятичное): ");
    scanf("%lf", &dy);
    printf("Операция (1 - Сложение, 2 - Вычитание): ");
    scanf("%d", &op);

    FP_CUSTOM x = to_custom(dx);
    FP_CUSTOM y = to_custom(dy);

    printf("\n--- Представление операндов ---\n");
    printf("X: "); print_bits_custom(x.raw);
    printf("Y: "); print_bits_custom(y.raw);

    FP_CUSTOM res = fp_add_sub(x, y, (op == 2));

    printf("\n--- Результат ---\n");
    printf("Z: "); print_bits_custom(res.raw);
    printf("Значение Z: %.10f\n", from_custom(res));
    
    double expected = (op == 1) ? (dx + dy) : (dx - dy);
    printf("Ожидается:   %.10f\n", expected);

    return 0;
}
