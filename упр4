#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <stdint.h>
#include <math.h>
#include <locale.h>

// --- КОНСТАНТЫ IEEE 754 SINGLE PRECISION ---
#define BIAS 127        // Смещение порядка (Bias)
#define MANT_BITS 23    // Количество бит мантиссы
#define HIDDEN_BIT (1U << MANT_BITS) // Скрытая единица (0x800000)

// Union позволяет обращаться к float как к набору битов
typedef union {
    float f;            // Значение как обычное число
    struct {
        uint32_t mantissa : MANT_BITS; // 23 бита мантиссы
        uint32_t exponent : 8;         // 8 бит порядка
        uint32_t sign : 1;             // 1 бит знака
    } parts;
    uint32_t raw;       // Все 32 бита сразу
} FP32;

// Функция для красивого вывода информации о числе
void print_fp_info(const char* name, FP32 fp) {
    int real_exp = (int)fp.parts.exponent - BIAS;
    printf("%s: Знак=%d, Порядок(hex)=%02X (реальный=%d), Мантисса=0x%06X\n",
        name, fp.parts.sign, fp.parts.exponent, real_exp, fp.parts.mantissa);
}

// ============================================================
// ФУНКЦИЯ УМНОЖЕНИЯ: Z = X * Y
// ============================================================
FP32 fp32_mul(FP32 a, FP32 b) {
    FP32 res;

    // 1. Если хотя бы одно число ноль, результат ноль
    if (a.raw == 0 || b.raw == 0) {
        res.raw = 0;
        return res;
    }

    // 2. Вычисляем знак результата
    // XOR: если знаки разные (0 и 1), результат будет 1 (минус)
    res.parts.sign = a.parts.sign ^ b.parts.sign;

    // 3. Вычисляем порядок
    // E_res = E_a + E_b - Bias
    // Вычитаем Bias, потому что он был добавлен дважды (в E_a и E_b)
    int e_res = (int)a.parts.exponent + (int)b.parts.exponent - BIAS;

    // 4. Работаем с мантиссами
    // Восстанавливаем скрытую единицу. Используем 64 бита (uint64_t), 
    // так как при умножении двух 24-битных чисел результат может быть до 48 бит.
    uint64_t m1 = ((uint64_t)a.parts.mantissa) | HIDDEN_BIT;
    uint64_t m2 = ((uint64_t)b.parts.mantissa) | HIDDEN_BIT;

    // Перемножаем мантиссы
    uint64_t m_prod = m1 * m2;

    // 5. Нормализация результата умножения
    // Произведение двух нормализованных чисел (1.x) лежит в диапазоне [1, 4).
    // Это значит, что старший бит может быть на позиции 47 или 46 (в 48-битном результате).

    // Проверяем бит 47 (старший возможный бит произведения)
    if (m_prod & (1ULL << 47)) {
        // Если бит 47 равен 1, значит результат >= 2.0 (переполнение разрядной сетки мантиссы)
        m_prod >>= 1; // Сдвигаем вправо на 1, чтобы вернуть в диапазон [1, 2)
        e_res++;      // Увеличиваем порядок на 1
    }

    // Теперь старшая единица гарантированно стоит на позиции 46.
    // Нам нужно оставить только 23 бита дробной части.
    // Сдвигаем вправо на 23 бита, чтобы "сбросить" лишние младшие биты и скрытую единицу.
    // (46 - 23 = 23). Биты 45..23 станут битами 22..0 новой мантиссы.
    m_prod >>= 23;

    // Записываем мантиссу (берем младшие 23 бита)
    res.parts.mantissa = (uint32_t)m_prod & (HIDDEN_BIT - 1);
    res.parts.exponent = e_res;

    return res;
}

// ============================================================
// ФУНКЦИЯ ДЕЛЕНИЯ: Z = X / Y
// ============================================================
FP32 fp32_div(FP32 a, FP32 b) {
    FP32 res;

    // 1. Проверка деления на ноль
    if (b.raw == 0) {
        printf("Ошибка: Деление на ноль!\n");
        res.raw = 0xFFFFFFFF; // Возвращаем NaN (Not a Number)
        return res;
    }
    // Если делимое ноль, то результат ноль
    if (a.raw == 0) {
        res.raw = 0;
        return res;
    }

    // 2. Знак результата
    res.parts.sign = a.parts.sign ^ b.parts.sign;

    // 3. Порядок
    // E_res = E_a - E_b + Bias
    // При вычитании смещенных порядков Bias исчезает, поэтому добавляем его обратно.
    int e_res = (int)a.parts.exponent - (int)b.parts.exponent + BIAS;

    // 4. Мантиссы
    uint64_t m1 = ((uint64_t)a.parts.mantissa) | HIDDEN_BIT;
    uint64_t m2 = ((uint64_t)b.parts.mantissa) | HIDDEN_BIT;

    // Чтобы получить точную дробную часть при целочисленном делении,
    // мы сдвигаем делимое (m1) влево на количество бит мантиссы (23).
    // Это освобождает место для результата деления после запятой.
    m1 <<= MANT_BITS;

    // Выполняем деление
    uint64_t m_quot = m1 / m2;

    // 5. Нормализация результата деления
    // Результат деления двух чисел из диапазона [1, 2) находится в диапазоне (0.5, 2).

    // Проверяем, где находится старшая единица частного.
    // После сдвига m1 влево на 23, ожидаемая позиция скрытой единицы — бит 23.

    if (!(m_quot & (1ULL << 23))) {
        // Если бит 23 равен 0, значит результат < 1.0 (например, 0.1xxxx)
        // Нужно сдвигать влево, пока не появится единица на 23-й позиции.
        while (!(m_quot & (1ULL << 23)) && e_res > 0) {
            m_quot <<= 1;
            e_res--; // Уменьшаем порядок при сдвиге влево
        }
    }
    else {
        // Если бит 23 установлен, проверяем, нет ли переполнения (бит 24)
        // Это случается, если результат >= 2.0
        if (m_quot & (1ULL << 24)) {
            m_quot >>= 1; // Сдвигаем вправо
            e_res++;      // Увеличиваем порядок
        }
    }

    // 6. Упаковка
    // Отбрасываем скрытую единицу (бит 23), оставляем только младшие 23 бита
    res.parts.mantissa = (uint32_t)m_quot & (HIDDEN_BIT - 1);
    res.parts.exponent = e_res;

    return res;
}

int main() {
    setlocale(LC_ALL, "Russian");

    float x_val, y_val;
    int choice;

    printf("--- Калькулятор IEEE 754 (Float) ---\n");
    printf("Выберите операцию:\n");
    printf("1. Умножение (*)\n");
    printf("2. Деление (/)\n");
    printf("Ваш выбор (1 или 2): ");
    scanf("%d", &choice);

    printf("Введите первое число (X): ");
    scanf("%f", &x_val);
    printf("Введите второе число (Y): ");
    scanf("%f", &y_val);

    FP32 x, y, z;
    x.f = x_val;
    y.f = y_val;

    printf("\n--- Исходные данные ---\n");
    print_fp_info("X", x);
    print_fp_info("Y", y);

    if (choice == 1) {
        printf("\n--- ВЫПОЛНЕНИЕ УМНОЖЕНИЯ ---\n");
        z = fp32_mul(x, y);
        printf("Результат алгоритма: %f\n", z.f);
        printf("Результат который должен быть:  %f\n", x_val * y_val);
    }
    else if (choice == 2) {
        printf("\n--- ВЫПОЛНЕНИЕ ДЕЛЕНИЯ ---\n");
        z = fp32_div(x, y);
        printf("Результат алгоритма: %f\n", z.f);
        printf("Результат которой должене быть:  %f\n", x_val / y_val);
    }
    else {
        printf("Неверный выбор операции.\n");
        return 1;
    }

    printf("\n--- Результат в битах ---\n");
    print_fp_info("Z", z);

    // Простая проверка на совпадение
    float expected = (choice == 1) ? (x_val * y_val) : (x_val / y_val);
    if (fabs(z.f - expected) < 1e-5f) {
        printf("Статус: OK\n");
    }
    else {
        printf("Статус: Возможна небольшая погрешность округления\n");
    }

    return 0;
}
